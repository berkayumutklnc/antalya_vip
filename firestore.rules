rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() { return request.auth != null; }
    function isAdmin() {
      return isAuthed() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ----------------- RESERVATIONS (private, full data) -----------------
    match /reservations/{id} {
      allow read: if isAdmin();
      // All writes via firebase-admin (server routes) — no client writes
      allow create, update, delete: if false;
    }

    // --------------- PUBLIC MIRROR (lookup via server API) ----------------
    match /reservations_public/{id} {
      // Public lookup now goes through API route — lock down
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // -------- PNR mapping — server-only writes ---------
    match /pnr/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // --------------------------- VEHICLES -------------------------------
    match /vehicles/{id} {
      // All reads now go through server API routes (firebase-admin)
      allow read: if isAdmin();
      // All writes via firebase-admin (server routes) — no client writes
      allow write: if false;
    }

    // --------------------------- ADMINS ---------------------------------
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    // ------------------- RESERVATION EVENTS (audit log) ------------------
    match /reservation_events/{id} {
      allow read: if isAdmin();
      // All writes via firebase-admin (server routes) — append-only
      allow create, update, delete: if false;
    }

    // --------------- NOTIFICATION LOGS (delivery attempts) ----------------
    match /notification_logs/{id} {
      allow read: if isAdmin();
      // All writes via firebase-admin (server routes)
      allow create, update, delete: if false;
    }

    // ------------------------- DEFAULT DENY -----------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
